<script>
document.addEventListener('DOMContentLoaded', () => {
    const editModal = document.getElementById('editFolderModal');
    if (!editModal) return;

    editModal.addEventListener('show.bs.modal', (event) => {
        const button = event.relatedTarget;
        if (!button) return;

        const id = button.getAttribute('data-id') || '';
        const name = button.getAttribute('data-name') || '';
        const parent = button.getAttribute('data-parent') || '';

        const editIdInput = document.getElementById('edit-id');
        const editNameInput = document.getElementById('edit-name');
        const editParentSelect = document.getElementById('edit-parent');

        if (editIdInput) editIdInput.value = id;
        if (editNameInput) editNameInput.value = name;
        if (editParentSelect) editParentSelect.value = parent;
    });
});
</script>